PORT=5000
FRONTEND_URL=http://localhost:5501
CORS_ORIGINS=
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/foodilee?schema=public"
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=

# Optional integrations
GROQ_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Leave false to collect payments in Food Ilee's Midtrans account and settle sellers manually.
# Set true only after Midtrans activates Partner Split and registers each seller merchant.
MIDTRANS_SPLIT_ENABLED=false
MIDTRANS_PARTNER_MERCHANT_ID=

# Optional Biteship shipping and webhook integration
BITESHIP_API_KEY=
BITESHIP_COURIERS=
BITESHIP_WEBHOOK_SECRET=
BITESHIP_COD_SETTLEMENT_DAYS=7_days
